        },
        {
          "id": "splitXplorer.section9",
          "name": "Custom Section 7",
          "when": "splitXplorer.slot9"
        },
        {
          "id": "splitXplorer.section10",
          "name": "Custom Section 8",
          "when": "splitXplorer.slot10"
        },
        {
          "id": "splitXplorer.section11",
          "name": "Custom Section 9",
          "when": "splitXplorer.slot11"
        },
        {
          "id": "splitXplorer.section12",
          "name": "Custom Section 10",
          "when": "splitXplorer.slot12"
        }
      ]
    },
