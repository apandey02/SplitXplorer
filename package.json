{
  "name": "splitxplorer",
  "displayName": "SplitXplorer",
  "description": "Split the Explorer into named, collapsible sections: Gitacknowledged, Gitignored, and your own sections with glob rules and drag and drop.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SplitXplorer",
      "properties": {
        "splitXplorer.dragBehavior": {
          "type": "string",
          "enum": [
            "move",
            "copy"
          ],
          "enumDescriptions": [
            "Dragging between sections moves the item out of the source section.",
            "Dragging between sections leaves the item in the source section too."
          ],
          "default": "move",
          "description": "What happens when you drag a file or folder from one SplitXplorer section to another."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "splitXplorer.section1",
          "name": "Gitacknowledged",
          "when": "splitXplorer.slot1"
        },
        {
          "id": "splitXplorer.section2",
          "name": "Gitignored",
          "when": "splitXplorer.slot2"
        },
        {
          "id": "splitXplorer.section3",
          "name": "Custom Section 1",
          "when": "splitXplorer.slot3"
        },
        {
          "id": "splitXplorer.section4",
          "name": "Custom Section 2",
          "when": "splitXplorer.slot4"
        },
        {
